digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.45, ranksep=0.42, pad=0.35, bgcolor="white", compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=0.8, margin="0.18,0.08"];
  edge  [fontname="Helvetica", fontsize=10, color="#5F5E5A", arrowsize=0.7];

  user [label="Parent + child\nname · age 5-10 · genre menu (0 auto, 1-11, 12 custom)\nidea · \"today I...\" moment", fillcolor="#F1EFE8", color="#5F5E5A"];

  subgraph cluster_core {
    label="CORE  ·  gpt-3.5-turbo only"; fontcolor="#3C3489"; style="rounded,dashed"; color="#7F77DD";
    kw       [label="Keyword screen (code)\nbanned words per age tier", fillcolor="#E1F5EE", color="#0F6E56"];
    classify [label="1. Classifier + safety gate\ngenre · soften / block · must-include", fillcolor="#E1F5EE", color="#0F6E56"];
    plan     [label="2. Planner\narc beats → 4/5/6 pages · characters\nsignature detail · breathing game", fillcolor="#EEEDFE", color="#534AB7"];
    write    [label="3. Storyteller  (temp 0.8)\nage tone · 400-800 words", fillcolor="#EEEDFE", color="#534AB7"];

    subgraph cluster_judge {
      label="4. Judge"; fontcolor="#085041"; style="rounded"; color="#1D9E75";
      code    [label="Code checks\nwords · pages · names\nmoral · sentence length", fillcolor="#E1F5EE", color="#0F6E56"];
      safety  [label="Safety judge (temp 0)\nage rules · imitable\nbehaviour — VETO", fillcolor="#E1F5EE", color="#0F6E56"];
      quality [label="Quality judge (temp 0)\n12-14 yes/no checklist\n→ score in code", fillcolor="#E1F5EE", color="#0F6E56"];
    }
    decide  [label="Pass?\nsafe AND no code issues AND score ≥ 8.5\n(regression guard keeps best draft)", shape=diamond, style="filled", fillcolor="#FAEEDA", color="#854F0B", fontsize=11];
    revise  [label="5. Reviser\nsafety → requirements → notes\nmax 3 rounds", fillcolor="#EEEDFE", color="#534AB7"];
    show    [label="Story in terminal", fillcolor="#F1EFE8", color="#5F5E5A"];
    fb      [label="Feedback screen\nsoften unsafe asks · adjust length", fillcolor="#E1F5EE", color="#0F6E56"];
  }

  subgraph cluster_book {
    label="SURPRISE  ·  optional storybook"; fontcolor="#712B13"; style="rounded,dashed"; color="#D85A30";
    scenes [label="Art director (gpt-3.5)\nscene per page + character sheet", fillcolor="#EEEDFE", color="#534AB7"];
    voice  [label="Voice director (gpt-3.5)\nmood · expressive lines", fillcolor="#EEEDFE", color="#534AB7"];
    img    [label="Illustrator\nimage model", fillcolor="#FAECE7", color="#993C1D"];
    nari   [label="Nari\nTTS model, soothing by age", fillcolor="#FAECE7", color="#993C1D"];
    player [label="Storybook player (HTML)\nbook opens · moving art · read-along · night-light", fillcolor="#F1EFE8", color="#5F5E5A"];
  }

  user -> kw -> classify -> plan -> write -> code;
  write -> safety; write -> quality;
  code -> decide; safety -> decide; quality -> decide;
  decide -> revise [label=" no"];
  revise -> code [style=dashed, label=" re-judge"];
  decide -> show [label=" yes"];
  show -> fb [label=" parent asks\n for a change"];
  fb -> revise;
  show -> scenes [label=" done"]; show -> voice;
  scenes -> img; voice -> nari; img -> player; nari -> player;
}
