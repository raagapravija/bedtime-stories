// Bedtime Story Maker - block diagram of the default workflow (compact).
// Render: dot -Tpng -Gdpi=130 docs/architecture.dot -o docs/architecture.png
//         dot -Tsvg docs/architecture.dot -o docs/architecture.svg
// Details (prompt names, what each call sends) are in the README table under the diagram.
// Pink = gpt-3.5 call, green = code, purple = data, grey = user / output.
digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.25, ranksep=0.28, pad=0.2, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=0.8, margin="0.12,0.05"];
  edge  [fontname="Helvetica", fontsize=9, color="#5F5E5A", arrowsize=0.6];

  user   [label="Parent: name · age · kind of story", fillcolor="#F1EFE8", color="#5F5E5A"];
  guard  [label="Input guard + safety screen", fillcolor="#E1F5EE", color="#0F6E56"];

  ideas  [label="Premise bank\n3 story ideas", fillcolor="#EEEDFE", color="#534AB7"];
  listen [label="Young listener\npicks 1", fillcolor="#FBEAF0", color="#993556"];
  lib    [label="Story library\n1 example (voice)", fillcolor="#EEEDFE", color="#534AB7"];
  write  [label="3 Storytellers\nwrite drafts in parallel", fillcolor="#FBEAF0", color="#993556"];
  pick   [label="Side-by-side judge\npicks the best draft", fillcolor="#FBEAF0", color="#993556"];
  judge  [label="Judge + code checks\nsafety · score · fixes", fillcolor="#FCEBEB", color="#A32D2D"];
  revise [label="Storyteller revises once\n(kept only if better)", fillcolor="#FBEAF0", color="#993556"];
  tidy   [label="House style (code)\nread-aloud fixes", fillcolor="#E1F5EE", color="#0F6E56"];
  story  [label="Story on the page", fillcolor="#F1EFE8", color="#5F5E5A"];
  change [label="\"Make it funnier\"\nedited, re-judged", fillcolor="#F1EFE8", color="#5F5E5A"];

  user -> guard -> ideas;
  ideas -> listen [label=" 3 ideas"];
  listen -> lib [label=" 1 idea"];
  lib -> write;
  write -> pick [label=" 3 drafts"];
  pick -> judge [label=" winner"];
  judge -> revise [label=" notes"];
  revise -> judge [label=" re-judge", style=dashed];
  judge -> tidy [label=" the better version"];
  tidy -> story;
  story -> change [style=dashed, label=" parent asks"];
  change -> judge [style=dashed, constraint=false];

  { rank=same; judge; revise; }
  { rank=same; story; change; }
}
