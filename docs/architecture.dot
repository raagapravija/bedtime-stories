digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.5, ranksep=0.45, pad=0.35, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=0.8, margin="0.2,0.09"];
  edge  [fontname="Helvetica", fontsize=10, color="#5F5E5A", arrowsize=0.7];

  user [label="Parent on the web page\nname · age 5-10 · genre (Surprise me, 11 genres, My own idea)", fillcolor="#F1EFE8", color="#5F5E5A"];
  guard [label="Input guard (code)\nclean text · valid name · injection check", fillcolor="#E1F5EE", color="#0F6E56"];
  classify [label="Classifier + safety gate  (only for \"My own idea\")\nsoften / block · genre · must-include", fillcolor="#E1F5EE", color="#0F6E56"];
  plan  [label="Planner\nbeats → pages (layout decided in code)\ncharacters · signature detail · breathing game", fillcolor="#EEEDFE", color="#534AB7"];
  write [label="Storyteller  (temp 0.8)\nage tone · 400-800 words", fillcolor="#EEEDFE", color="#534AB7"];

  subgraph cluster_judge {
    label="Judge"; fontcolor="#085041"; style="rounded"; color="#1D9E75";
    code  [label="Code checks (free)\nwords · pages · name\nbanned words · moral", fillcolor="#E1F5EE", color="#0F6E56"];
    llmj  [label="One LLM judge call (temp 0)\nsafety issues (veto)\n+ yes/no checklist → score in code", fillcolor="#E1F5EE", color="#0F6E56"];
  }
  decide [label="Pass?\nsafe AND no code issues AND score ≥ 8", shape=diamond, style="filled", fillcolor="#FAEEDA", color="#854F0B", fontsize=11];
  revise [label="Reviser\nsafety → requirements → notes\nat most 1 round · keeps best draft", fillcolor="#EEEDFE", color="#534AB7"];
  show   [label="Story on the web page", fillcolor="#F1EFE8", color="#5F5E5A"];

  user -> guard;
  guard -> classify [label=" own idea"];
  guard -> plan [label=" genre picked\n (no screening call)"];
  classify -> plan -> write;
  write -> code; write -> llmj;
  code -> decide; llmj -> decide;
  decide -> show [label=" yes"];
  decide -> revise [label=" no"];
  revise -> code [style=dashed, label=" judge again"];
  show -> revise [label=" \"make it funnier\"\n (guarded, then judged again)"];
}
