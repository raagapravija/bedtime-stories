// Bedtime Story Maker - block diagram (whole-story mode, the default).
// Render: dot -Tpng -Gdpi=110 docs/architecture.dot -o docs/architecture.png
//         dot -Tsvg docs/architecture.dot -o docs/architecture.svg
// Top to bottom is the usual order of one run. Each row is one agent tool and the
// components it calls. Every LLM box names its prompt in bedtime/prompts.py.
digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.35, ranksep=0.32, pad=0.3, bgcolor="white",
         compound=true, newrank=true, splines=spline];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=0.9, margin="0.16,0.07"];
  edge  [fontname="Helvetica", fontsize=10, color="#5F5E5A", arrowsize=0.7];

  // ------------------------------------------------------------------ rows
  user [label="USER (parent): web page or terminal\nname · age 5-10 · something from today · a shelf (11 genres, Surprise me, My own idea)",
        fillcolor="#F1EFE8", color="#5F5E5A", fontsize=13];
  guard  [label="Input guard (code)\nclean text · real names only · injection phrases", fillcolor="#E1F5EE", color="#0F6E56"];
  screen [label="Safety screen  (LLM, only for \"My own idea\")\nprompt: CLASSIFIER_SYSTEM\nsoften or block · original characters · genre", fillcolor="#E1F5EE", color="#0F6E56"];

  subgraph cluster_agent {
    label="STORYTELLER AGENT\ngpt-3.5-turbo, tool calling\nprompt: AGENT_SYSTEM_WHOLE\nobserve → decide → ONE tool";
    fontcolor="#633806"; style="rounded"; color="#BA7517"; penwidth=1.8; fontsize=12;
    t1 [label="1  browse_ideas", fillcolor="#FAEEDA", color="#854F0B"];
    t2 [label="2  pitch_ideas\n(three pitches)", fillcolor="#FAEEDA", color="#854F0B"];
    t3 [label="3  search_library", fillcolor="#FAEEDA", color="#854F0B"];
    t4 [label="4  plan_beats(note)", fillcolor="#FAEEDA", color="#854F0B"];
    t5 [label="5  write_drafts(note)", fillcolor="#FAEEDA", color="#854F0B"];
    t6 [label="6  review_story", fillcolor="#FAEEDA", color="#854F0B"];
    t7 [label="7  rewrite_passage /\n    expand_passage", fillcolor="#FAEEDA", color="#854F0B"];
    t8 [label="8  read_aloud", fillcolor="#FAEEDA", color="#854F0B"];
    t9 [label="9  finish", fillcolor="#FAEEDA", color="#854F0B"];
    t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> t8 -> t9 [color="#BA7517", penwidth=1.3];
    t7 -> t6 [color="#BA7517", style=dashed, label=" review again", constraint=false];
  }

  ideas    [label="Premise bank (code data)\n98 seeds: a want · a funny obstacle · a twist\nspace & animal seeds: hero + a true fact", fillcolor="#EEEDFE", color="#534AB7"];
  listener [label="YOUNG LISTENER  (LLM)\nprompt: LISTENER_SYSTEM\na child of this age picks one pitch + why", fillcolor="#FBEAF0", color="#993556"];
  memory   [label="Memory (JSON file)\nrecent seeds & names\neach child's stories (sequels)", fillcolor="#EEEDFE", color="#534AB7"];
  library  [label="Story library (code data)\n12 examples · 3 age bands × 4 moods\nthe voice to copy, never the plot", fillcolor="#EEEDFE", color="#534AB7"];
  head [label="HEAD WRITER  (LLM)\nprompt: HEAD_WRITER_SYSTEM + beats_prompt (with a worked example)\nbeat sheet: funny rule · 3 tries (plan → set-up → punchline → so next)\nplanted idea · solution · twist · running joke ×3 · last line", fillcolor="#FBEAF0", color="#993556"];
  beatcheck [label="Beat-sheet checks (code)\nreal punchlines, not descriptions\nchild is the hero · seed's twist & fact · age-safe", fillcolor="#E1F5EE", color="#0F6E56"];
  drafts [label="3 DRAFT WRITERS, in parallel  (LLM, each in two halves)\nprompt: WHOLE_WRITER_SYSTEM + whole_story_prompt\nthe library example is sent as their \"own earlier story\"\nangles: straight · comedy · characters", fillcolor="#FBEAF0", color="#993556"];
  pick [label="SIDE-BY-SIDE JUDGE  (LLM, 3 pairs × 2 orders, parallel)\nprompt: PAIRWISE_SYSTEM + pairwise_prompt\nplot · creativity · development · language · bedtime\nthe winning draft becomes the story", fillcolor="#FBEAF0", color="#993556"];
  checks [label="Code checks\n500-800 words · age words · repeats · copying\nhard words · true fact explained", fillcolor="#E1F5EE", color="#0F6E56"];
  judge  [label="JUDGE  (LLM)\nprompt: JUDGE_SYSTEM + judge_prompt\nsafety veto · yes/no checklist\n→ score computed in code → report card", fillcolor="#FCEBEB", color="#A32D2D"];
  double [label="Safety double-check  (LLM, per flag)\nprompt: SAFETY_CHECK_SYSTEM\nkeeps only real problems · fails closed", fillcolor="#FCEBEB", color="#A32D2D"];
  scene  [label="Scene writer  (LLM)\nprompt: WRITER_SYSTEM + scene_prompt\nrewrite or lengthen ONE passage, never new events", fillcolor="#FBEAF0", color="#993556"];
  rehearse [label="Rehearsal (code)\none breath per sentence · long ones split in code\ntongue-twisters · same starts", fillcolor="#E1F5EE", color="#0F6E56"];
  rails [label="GUARDRAILS (code) decide\nfinish only if safe, 500-800 words, reviewed and rehearsed\nevery refusal says why · 2 polish edits after a passing draft\nstuck after 4 refusals · budgets: 22 tool calls, 90 s", fillcolor="#FCEBEB", color="#A32D2D"];
  auto  [label="Autopilot fallback (code)\nsame tools, fixed order", fillcolor="#FCEBEB", color="#A32D2D"];
  out [label="STORY on the page: title page + pages, read aloud with the computer's own voice\n(the agent's steps appear on the book's cover while it works)\n\nThe parent can ask for a change (\"make it funnier\"): checked for injection, fenced as <parent_change>,\nand the same agent edits the story page by page with rewrite_passage → review_story → finish.", fillcolor="#F1EFE8", color="#5F5E5A", fontsize=13];
  trace [label="Tracer (code) → output/debug/*.json\nevery turn, prompt, reply and time", fillcolor="#F1EFE8", color="#5F5E5A"];

  { rank=same; guard; screen; }
  { rank=same; t1; ideas; }
  { rank=same; t2; listener; memory; }
  { rank=same; t3; library; }
  { rank=same; t4; head; beatcheck; }
  { rank=same; t5; drafts; pick; }
  { rank=same; t6; checks; judge; double; }
  { rank=same; t7; scene; }
  { rank=same; t8; rehearse; }
  { rank=same; t9; rails; auto; }

  // ------------------------------------------------------------------ flow
  user -> guard;
  guard -> screen [dir=both, label=" own idea →\n safe brief"];
  guard -> t1 [label=" the brief (fenced, untrusted)", lhead=cluster_agent];

  t1 -> ideas [dir=both, style=dashed, label=" 5 seeds"];
  t2 -> listener [dir=both, style=dashed, label=" 3 pitches → choice"];
  listener -> memory [style=invis];
  t2 -> memory [dir=both, style=dashed, constraint=false];
  t3 -> library [dir=both, style=dashed, label=" 1 example"];
  t4 -> head [style=dashed, label=" seed + choice +\n age rules + note"];
  head -> beatcheck;
  beatcheck -> t4 [style=dashed, color="#A32D2D", label=" problems → redo once", constraint=false];
  t5 -> drafts [style=dashed, label=" beat sheet"];
  drafts -> pick [label=" 3 drafts"];
  pick -> t5 [style=dashed, label=" winner", constraint=false];
  t6 -> checks [style=dashed];
  checks -> judge [label=" story"];
  judge -> double [label=" each safety flag"];
  judge -> t6 [style=dashed, label=" report card", constraint=false];
  t7 -> scene [style=dashed, label=" the card's fix"];
  t8 -> rehearse [style=dashed];
  t9 -> rails [dir=both, label=" asks /\n refused + why"];
  rails -> auto [style=dotted, label=" agent error /\n stuck / out of time"];
  rails -> out [label=" allowed"];
  auto -> out;
  t9 -> out [style=invis];
  out -> trace [style=invis];

}
